# Provider / retry configuration (used in later implementation steps)
INBOXVALID_API_URL=http://localhost:0/mock
INBOXVALID_API_KEY=mock-key

# Retry: max attempts after the first call (default: 2 → 3 total tries)
RETRY_MAX_ATTEMPTS=2
RETRY_BASE_DELAY_MS=100

# Comma-separated disposable domains for local checks
DISPOSABLE_DOMAINS=mailinator.com,tempmail.com,guerrillamail.com
